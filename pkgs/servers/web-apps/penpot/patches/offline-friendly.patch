diff --git a/backend/scripts/build b/backend/scripts/build
index 0df9ff8b9..05c431bee 100755
--- a/backend/scripts/build
+++ b/backend/scripts/build
@@ -22,7 +22,10 @@ chmod +x target/dist/run.sh;
 chmod +x target/dist/manage.py
 
 # Prefetch templates
-rm -rf builtin-templates;
-mkdir builtin-templates;
-bb ./scripts/prefetch-templates.clj resources/app/onboarding.edn builtin-templates/
+# Allow offline builds when templates are preseeded.
+if [ ! -d builtin-templates ] || [ -z "$(ls -A builtin-templates)" ];  then
+    rm -rf builtin-templates;
+    mkdir builtin-templates;
+    bb ./scripts/prefetch-templates.clj resources/app/onboarding.edn builtin-templates/
+fi
 cp -r builtin-templates target/dist/
