+    # The pre- and post-training response checks cannot stay enabled here.
+    # With this pinned public model, Unsloth's fast generation path fails on
+    # the NVIDIA test runner with a tensor-shape mismatch before decoding.
+    import shutil
+    from unittest import mock
+
+    # Merging copies the base safetensors out of the read-only Nix store and
+    # then mutates the copy, so the copied file must be made writable first.
+    original_copy2 = shutil.copy2
+
+    def writable_copy2(src, dst, *args, **kwargs):
+        copied = Path(original_copy2(src, dst, *args, **kwargs))
+        copied.chmod(copied.stat().st_mode | 0o200)
+        return str(copied)
+
+    with mock.patch.object(shutil, "copy2", side_effect=writable_copy2):
+        model.save_pretrained_merged(
+            unsloth_merged_path,
+            tokenizer,
+            save_method="merged_16bit",
+        )
